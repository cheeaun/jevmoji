{
  "name": "jevmoji",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Type anything. Get related emojis scored 0–3 with Jev.",
  "homepage": "https://jevmoji.cheeaun.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheeaun/jevmoji.git"
  },
  "bugs": {
    "url": "https://github.com/cheeaun/jevmoji/issues"
  },
  "keywords": [
    "emoji",
    "typesafe",
    "jev",
    "cloudflare-workers",
    "vite"
  ],
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "catalog": "node scripts/build-emojis.mjs",
    "probe": "node scripts/score-probe.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
